{
  // 取込元・出力先は各自の環境に合わせて設定する。**出荷デフォルトは安全な空値**(§14)。
  // 空のままだと取り込みは一切行われない(初回起動→設定前の誤インポートを防ぐ)。
  "RadioRoot": "",   // 例: "I:\\radio\\tmp\\RADIO"(らじれこの録音ルート)
  "OutputRoot": "",  // 例: "\\\\NAS\\share\\media\\radio"(Jellyfin ライブラリ。UNC 推奨)

  // 相対パスは radirec.json のあるディレクトリ基準で解決される(ADR-0006)。
  // 既定では ledger / stations / programs は %LocalAppData%\radirec\ に同居する(ADR-0013)。
  "LedgerPath": "ledger.db",
  "StationsFile": "stations.json",
  "ProgramsFile": "programs.json",

  "StabilitySeconds": 15,
  "Genre": "ラジオ",
  "SkipPatterns": [
    "この時間はＮＨＫネットラジオでは",
    "この時間はNHKネットラジオでは"
  ],
  "KnownRecordingKinds": [
    "TimeFree"
  ],

  "JellyfinUrl": "",
  "JellyfinApiKey": "",

  "ScanIntervalSeconds": 120,
  "WatchDebounceSeconds": 10,

  // 新規取込時に取込通知(トースト)を出す。トレイ常駐が in-process で表示する(ADR-0012)。
  "NotificationsEnabled": true
}
