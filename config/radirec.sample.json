{
  "RadioRoot": "I:\\radio\\tmp",
  "OutputRoot": "\\\\192.168.11.121\\share\\media\\radio",

  // 相対パスは radirec.json のあるディレクトリ基準で解決される(ADR-0006)。
  // 既定では ledger / stations / programs は %ProgramData%\radirec\ に同居する。
  "LedgerPath": "ledger.db",
  "StationsFile": "stations.json",
  "ProgramsFile": "programs.json",

  "StabilitySeconds": 15,
  "Genre": "ラジオ",
  "SkipPatterns": [
    "この時間はＮＨＫネットラジオでは",
    "この時間はNHKネットラジオでは"
  ],
  "KnownRecordingKinds": [
    "TimeFree"
  ],

  "JellyfinUrl": "",
  "JellyfinApiKey": "",

  "ScanIntervalSeconds": 120,
  "WatchDebounceSeconds": 10,

  // 新規取込時に取込要約シグナル(EventLog EventID 1001)を発行する(ADR-0008)。
  // 受け手(GUI/常駐)がこれを購読しデスクトップ通知を表示する。
  "NotificationsEnabled": true
}
