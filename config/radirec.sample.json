{
  // 取込元・出力先は各自の環境に合わせて設定する。**出荷デフォルトは安全な空値**(§14)。
  // 空のままだと取り込みは一切行われない(初回起動→設定前の誤インポートを防ぐ)。
  "RadioRoot": "",   // 例: "I:\\radio\\tmp\\RADIO"(らじれこの録音ルート)
  "OutputRoot": "",  // 例: "\\\\NAS\\share\\media\\radio"(Jellyfin ライブラリ。UNC 推奨)

  // 相対パスは radirec.json のあるディレクトリ基準で解決される(ADR-0006)。
  // 既定では ledger / stations / programs は %LOCALAPPDATA%\RadirecData\ に同居する(ADR-0013)。
  "LedgerPath": "ledger.db",
  "StationsFile": "stations.json",
  "ProgramsFile": "programs.json",

  "StabilitySeconds": 15,
  "Genre": "ラジオ",
  "SkipPatterns": [
    "この時間はＮＨＫネットラジオでは",
    "この時間はNHKネットラジオでは"
  ],
  "KnownRecordingKinds": [
    "TimeFree"
  ],

  "JellyfinUrl": "",
  "JellyfinApiKey": "",

  "ScanIntervalSeconds": 120,
  "WatchDebounceSeconds": 10,

  // 旧設定(#152・ADR-0019)。新規取込のトーストを出すかは管理画面の設定ページで切り替え、gui-settings.json に持つ。
  // ここは gui-settings.json にまだ値が無いときの初期値としてだけ読む。取込失敗のトーストはこの値に関係なく出る。
  "NotificationsEnabled": true,

  // アプリ内自己更新(Velopack。S6)。
  // UpdatePrerelease: prerelease(RC)も更新対象にするか。既定 false(安定版のみ)。RC 検証時だけ true。
  "UpdatePrerelease": false,
  // UpdateToken: 更新フィード(GitHub Releases)を読むトークン。**private repo では必須**
  //   (contents:read の fine-grained PAT)。空なら認証なし(public 扱い)。
  "UpdateToken": ""
}
