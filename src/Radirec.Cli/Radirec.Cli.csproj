<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>radirec</AssemblyName>
    <RootNamespace>Radirec.Cli</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- 単一自己完結 exe(Release publish 時。ADR-0005)。TagLib#/Spectre のリフレクションを守るため
       Trim しない。ネイティブ e_sqlite3 は単一ファイルへ畳み込み実行時抽出する(検証済み・必須指定)。
       Debug ビルドは軽量(RID/自己完結なし)に保ち開発ループを速く保つ。 -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Radirec.Core\Radirec.Core.csproj" />
    <ProjectReference Include="..\Radirec.Hosting\Radirec.Hosting.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 常駐/制御(Hosting・WindowsServices・EventLog・SystemEvents)は撤去済み(ADR-0012)。
         radirec.exe は単発 CLI(ingest / refresh)専用に縮小した。 -->
    <PackageReference Include="Spectre.Console.Cli" />
  </ItemGroup>

</Project>
