<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>radirec</AssemblyName>
    <RootNamespace>Radirec.Cli</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- `-windows` TFM を非 Windows(WSL/Linux CI)でもビルド可能にする(Radirec.Gui と同じ理由)。
         Windows 実機ビルドでは無害。これで CI も開発者もフラグ無しの `dotnet build Radirec.slnx` で
         全プロジェクトを検証できる。
         ※ Gui と違い **Cli は Debug ビルドなら Linux でも起動する**(WPF/WinForms を使わないため。
         ヘルプ表示も動く)。**Release ビルドは起動しない** — 下の Release 用 PropertyGroup が
         win-x64 self-contained にするので、`dotnet radirec.dll` は libhostpolicy.so が見つからずに終了する。
         Windows 前提なのは実行環境のほう — 出荷物が win-x64 self-contained で、config が
         I:/UNC のパスを指すため。TFM の `-windows` はサービス時代(ADR-0005)の名残でもある。 -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <!-- 単一自己完結 exe(Release publish 時。ADR-0005)。TagLib#/Spectre のリフレクションを守るため
       Trim しない。ネイティブ e_sqlite3 は単一ファイルへ畳み込み実行時抽出する(検証済み・必須指定)。
       Debug ビルドは軽量(RID/自己完結なし)に保ち開発ループを速く保つ。 -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Radirec.Core\Radirec.Core.csproj" />
    <ProjectReference Include="..\Radirec.Hosting\Radirec.Hosting.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 常駐/制御(Hosting・WindowsServices・EventLog・SystemEvents)は撤去済み(ADR-0012)。
         radirec.exe は単発 CLI(ingest / refresh)専用に縮小した。 -->
    <PackageReference Include="Spectre.Console.Cli" />
  </ItemGroup>

</Project>
