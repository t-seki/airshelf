<!--
  管理画面の番組ページ(#154・requirements §10.3・ADR-0017)。DataContext は Radirec.Gui.Core の ProgramsPageViewModel。
  文言は docs/mockups/management-window.md の「番組」の節に従い、各所に W-ID を書いておく。
  スタイルと変換はこのファイルの中で持つ(UserControl は InitializeComponent の時点で親ウィンドウの StaticResource を探せない)。
-->
<UserControl x:Class="Radirec.Gui.Pages.ProgramsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m="clr-namespace:Radirec.Gui.Core.Management;assembly=Radirec.Gui.Core">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />

        <Style x:Key="PageHeading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="SectionHeading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Sub" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource SurfaceStrokeColorDefaultBrush}" />
        </Style>
        <!--
          Button / TextBox / DataGridRow にはキー付きのスタイルを置かない(#171。ManagementWindow.xaml の Window.Resources の注記)。
          当てると Fluent テーマの暗黙のスタイルを受け取らず、ダークでもクラシックの見た目になる。見た目の値は属性に書く。
        -->
        <Thickness x:Key="SmallButtonPadding">12,3</Thickness>
        <Thickness x:Key="SmallButtonMargin">6,0,0,0</Thickness>
        <Thickness x:Key="ButtonPadding">16,5</Thickness>
        <Thickness x:Key="ButtonMargin">8,0,0,0</Thickness>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,10,0,3" />
        </Style>
        <Style x:Key="Error" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>
        <!-- 一覧のセル。保存していない行(追加・編集)を太字で目立たせる(行のスタイルは置けないので、セルで見る) -->
        <Style x:Key="Cell" TargetType="TextBlock">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsChanged}" Value="True">
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Wrapped" TargetType="TextBlock" BasedOn="{StaticResource Cell}">
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Resources>

    <DockPanel Margin="18,14">
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource PageHeading}" Text="番組" />

        <!-- W-211(縮退:radirec.json を読めない) -->
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap"
                   Text="{x:Static m:ProgramsPageViewModel.Unavailable}"
                   Visibility="{Binding IsUnavailable, Converter={StaticResource Visible}}" />

        <!-- W-212 / W-213(programs.json を使わない設定) -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}"
                Visibility="{Binding IsUnused, Converter={StaticResource Visible}}">
            <StackPanel>
                <TextBlock TextWrapping="Wrap" Text="{x:Static m:ProgramsPageViewModel.Unused}" />
                <TextBlock Style="{StaticResource Sub}" Margin="0,6,0,0" Text="{x:Static m:ProgramsPageViewModel.UnusedHint}" />
            </StackPanel>
        </Border>

        <!-- programs.json を読めない(壊れている等)。直してから読み込み直す(W-276) -->
        <StackPanel DockPanel.Dock="Top" Visibility="{Binding IsLoadFailed, Converter={StaticResource Visible}}">
            <TextBlock Style="{StaticResource Error}" Text="{Binding LoadError}" />
            <Button HorizontalAlignment="Left" Padding="{StaticResource SmallButtonPadding}" Margin="0,8,0,0"
                    Content="読み込み直す" Command="{Binding ReloadCommand}" />
        </StackPanel>

        <Grid>
            <!-- ========== 一覧 ========== -->
            <DockPanel Visibility="{Binding IsListMode, Converter={StaticResource Visible}}">
                <StackPanel DockPanel.Dock="Top" Visibility="{Binding IsReady, Converter={StaticResource Visible}}">
                    <!-- W-201 -->
                    <TextBlock Style="{StaticResource Sub}" Text="{x:Static m:ProgramsPageViewModel.Intro}" />
                    <!-- W-208 / W-209 -->
                    <DockPanel Margin="0,8,0,0" Visibility="{Binding HasChanges, Converter={StaticResource Visible}}">
                        <Button DockPanel.Dock="Right" Padding="{StaticResource SmallButtonPadding}" Margin="{StaticResource SmallButtonMargin}" Content="変更を取り消す"
                                Command="{Binding RevertCommand}" />
                        <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding ChangesText}" />
                    </DockPanel>
                </StackPanel>

                <!-- W-207(確認)/ W-214(取り込みが止まっている) -->
                <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0" LastChildFill="False"
                           Visibility="{Binding IsReady, Converter={StaticResource Visible}}">
                    <Button DockPanel.Dock="Right" Padding="{StaticResource ButtonPadding}" Margin="{StaticResource ButtonMargin}" Content="確認"
                            Command="{Binding ConfirmCommand}" />
                    <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Style="{StaticResource Sub}"
                               Text="{Binding ConfirmNote}" />
                </DockPanel>

                <Grid Visibility="{Binding IsReady, Converter={StaticResource Visible}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="2*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- W-202 / W-206 / W-210(件数) -->
                    <DockPanel Grid.Row="0" Margin="0,14,0,6">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Padding="{StaticResource SmallButtonPadding}" Margin="{StaticResource SmallButtonMargin}" Content="追加" Command="{Binding AddProgramCommand}" />
                            <Button Padding="{StaticResource SmallButtonPadding}" Margin="{StaticResource SmallButtonMargin}" Content="編集" Command="{Binding EditProgramCommand}" />
                            <Button Padding="{StaticResource SmallButtonPadding}" Margin="{StaticResource SmallButtonMargin}" Content="削除" Command="{Binding DeleteProgramCommand}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource SectionHeading}" Text="アルバム名と統合" />
                            <TextBlock Style="{StaticResource Sub}" Margin="12,0,0,0" VerticalAlignment="Center"
                                       Text="{Binding ProgramsCountText}" />
                        </StackPanel>
                    </DockPanel>
                    <!-- W-203 / W-204。行のダブルクリックで編集 -->
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Programs}"
                              SelectedItem="{Binding SelectedProgram, Mode=TwoWay}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              CanUserSortColumns="False" CanUserReorderColumns="False"
                              HeadersVisibility="Column" SelectionMode="Single"
                              GridLinesVisibility="Horizontal" MinHeight="80"
                              MouseDoubleClick="OnProgramGridDoubleClick">
                        <!-- RowStyle は置かない(Fluent の行のスタイルを上書きするため。#171)。太字はセル(Cell / Wrapped)で出す -->
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="放送局" Binding="{Binding Station}" Width="100"
                                                ElementStyle="{StaticResource Cell}" />
                            <DataGridTextColumn Header="フォルダ" Binding="{Binding Folders}" Width="250"
                                                ElementStyle="{StaticResource Wrapped}" />
                            <DataGridTextColumn Header="アルバム名" Binding="{Binding Album}" Width="230"
                                                ElementStyle="{StaticResource Wrapped}" />
                            <DataGridTextColumn Header="種類" Binding="{Binding Kind}" Width="100"
                                                ElementStyle="{StaticResource Cell}" />
                            <DataGridTextColumn Header="メモ" Binding="{Binding Note}" Width="*"
                                                ElementStyle="{StaticResource Wrapped}" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- W-205 / W-206 -->
                    <DockPanel Grid.Row="2" Margin="0,14,0,6">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Padding="{StaticResource SmallButtonPadding}" Margin="{StaticResource SmallButtonMargin}" Content="追加" Command="{Binding AddKeepCommand}" />
                            <Button Padding="{StaticResource SmallButtonPadding}" Margin="{StaticResource SmallButtonMargin}" Content="編集" Command="{Binding EditKeepCommand}" />
                            <Button Padding="{StaticResource SmallButtonPadding}" Margin="{StaticResource SmallButtonMargin}" Content="削除" Command="{Binding DeleteKeepCommand}" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource SectionHeading}" Text="分けておく兄弟フォルダ" />
                    </DockPanel>
                    <!-- W-205(列) -->
                    <DataGrid Grid.Row="3" ItemsSource="{Binding KeepSeparate}"
                              SelectedItem="{Binding SelectedKeep, Mode=TwoWay}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              CanUserSortColumns="False" CanUserReorderColumns="False"
                              HeadersVisibility="Column" SelectionMode="Single"
                              GridLinesVisibility="Horizontal" MinHeight="60"
                              MouseDoubleClick="OnKeepGridDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="放送局" Binding="{Binding Station}" Width="100"
                                                ElementStyle="{StaticResource Cell}" />
                            <DataGridTextColumn Header="フォルダの組" Binding="{Binding Folders}" Width="480"
                                                ElementStyle="{StaticResource Wrapped}" />
                            <DataGridTextColumn Header="メモ" Binding="{Binding Note}" Width="*"
                                                ElementStyle="{StaticResource Wrapped}" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <!-- W-210 -->
                    <TextBlock Grid.Row="4" Style="{StaticResource Sub}" Margin="0,4,0,0" Text="{Binding KeepCountText}" />
                </Grid>
            </DockPanel>

            <!-- ========== 編集フォーム(W-220〜W-229) ========== -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding IsFormMode, Converter={StaticResource Visible}}">
                <StackPanel MaxWidth="720" HorizontalAlignment="Left" MinWidth="480">
                    <!-- W-220 / W-228 / W-229 -->
                    <TextBlock Style="{StaticResource SectionHeading}" Text="{Binding FormHeading}" />
                    <!-- W-226(要対応の「統合する」「分けておく」から来た) -->
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,6" Text="{Binding FormNotice}"
                               Visibility="{Binding IsFormNoticeVisible, Converter={StaticResource Visible}}" />

                    <TextBlock Style="{StaticResource Label}" Text="放送局" />
                    <TextBox Text="{Binding FormStation, UpdateSourceTrigger=PropertyChanged}" />

                    <!-- アルバム名と統合:フォルダ(W-222)/ 分けておく:フォルダの組(W-228) -->
                    <TextBlock Style="{StaticResource Label}" Text="フォルダ"
                               Visibility="{Binding IsProgramFormMode, Converter={StaticResource Visible}}" />
                    <TextBlock Style="{StaticResource Label}" Text="フォルダの組"
                               Visibility="{Binding IsKeepFormMode, Converter={StaticResource Visible}}" />
                    <TextBox AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto" MinHeight="64" MaxHeight="140"
                             Text="{Binding FormFolders, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Style="{StaticResource Sub}" Margin="0,3,0,0"
                               Text="{x:Static m:ProgramsPageViewModel.FoldersHint}" />

                    <!-- アルバム名(W-223)。分けておく兄弟フォルダには無い -->
                    <StackPanel Visibility="{Binding IsProgramFormMode, Converter={StaticResource Visible}}">
                        <TextBlock Style="{StaticResource Label}" Text="アルバム名" />
                        <TextBox Text="{Binding FormAlbum, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Style="{StaticResource Sub}" Margin="0,3,0,0"
                                   Text="{x:Static m:ProgramsPageViewModel.AlbumHint}" />
                    </StackPanel>

                    <TextBlock Style="{StaticResource Label}" Text="メモ" />
                    <TextBox AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto" MinHeight="64" MaxHeight="140"
                             Text="{Binding FormNote, UpdateSourceTrigger=PropertyChanged}" />

                    <!-- W-224 / W-225 -->
                    <TextBlock Style="{StaticResource Error}" Text="{Binding FormErrorText}" />

                    <!-- W-227。Enter / Esc は、いま出している画面のボタンにだけ結ぶ(隠れた画面の既定のボタンと取り合わない) -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                        <Button Padding="{StaticResource ButtonPadding}" Margin="{StaticResource ButtonMargin}" Content="決定" IsDefault="{Binding IsFormMode}"
                                Command="{Binding CommitFormCommand}" />
                        <Button Padding="{StaticResource ButtonPadding}" Margin="{StaticResource ButtonMargin}" Content="キャンセル" IsCancel="{Binding IsFormMode}"
                                Command="{Binding CancelFormCommand}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- ========== 確かめている途中(W-240) ========== -->
            <Border VerticalAlignment="Top" Style="{StaticResource Card}"
                    Visibility="{Binding IsCheckingMode, Converter={StaticResource Visible}}">
                <TextBlock TextWrapping="Wrap" Text="{Binding CheckingText}" MinHeight="18" />
            </Border>

            <!-- ========== 確認(W-241〜W-250。保存済みの設定で確かめたときは W-252 / W-253 / W-312。#164) ========== -->
            <DockPanel Visibility="{Binding IsConfirmMode, Converter={StaticResource Visible}}">
                <!-- W-249 / W-312。既定のボタン(Enter)は「戻る」(ファイルを動かす側を既定にしない) -->
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                    <Button Padding="{StaticResource ButtonPadding}" Margin="{StaticResource ButtonMargin}" Content="保存して適用" Command="{Binding SaveAndApplyCommand}"
                            Visibility="{Binding IsDraftBasis, Converter={StaticResource Visible}}" />
                    <Button Padding="{StaticResource ButtonPadding}" Margin="{StaticResource ButtonMargin}" Content="保存だけ" Command="{Binding SaveOnlyCommand}"
                            Visibility="{Binding HasChanges, Converter={StaticResource Visible}}" />
                    <!-- W-312(保存するものが無いので「保存だけ」は無い) -->
                    <Button Padding="{StaticResource ButtonPadding}" Margin="{StaticResource ButtonMargin}" Content="適用" Command="{Binding ApplySavedCommand}"
                            Visibility="{Binding IsSavedBasis, Converter={StaticResource Visible}}" />
                    <Button Padding="{StaticResource ButtonPadding}" Margin="{StaticResource ButtonMargin}" Content="戻る"
                            IsDefault="{Binding IsConfirmBackDefault}" IsCancel="{Binding IsConfirmBackDefault}"
                            Command="{Binding BackCommand}" />
                </StackPanel>

                <!-- W-260〜W-262(コメントが消える確認)。確認の画面の上に出す -->
                <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0,12,0,0"
                        BorderBrush="{DynamicResource SystemFillColorCautionBrush}" BorderThickness="2"
                        Visibility="{Binding IsCommentsPromptVisible, Converter={StaticResource Visible}}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeading}" Text="{Binding CommentsHeading}" />
                        <TextBlock TextWrapping="Wrap" Margin="0,6,0,0" Text="{Binding CommentsBody}" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                            <Button Padding="{StaticResource ButtonPadding}" Margin="{StaticResource ButtonMargin}" Content="保存する"
                                    Command="{Binding ProceedAfterCommentsCommand}" />
                            <!-- 既定は「戻る」(W-262) -->
                            <Button Padding="{StaticResource ButtonPadding}" Margin="{StaticResource ButtonMargin}" Content="戻る"
                                    IsDefault="{Binding IsCommentsPromptVisible}" IsCancel="{Binding IsCommentsPromptVisible}"
                                    Command="{Binding CancelCommentsCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- W-241(保存済みの設定で確かめたときは、変えた設定が無いので出さない) -->
                        <TextBlock Style="{StaticResource SectionHeading}" Text="設定の変更"
                                   Visibility="{Binding IsDraftBasis, Converter={StaticResource Visible}}" />
                        <Grid Margin="0,6,0,0" Visibility="{Binding IsDraftBasis, Converter={StaticResource Visible}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource Sub}" Text="変更前" />
                                <!-- W-241。JSON を等幅で見せ、折り返さずに横に流す -->
                                <TextBox IsReadOnly="True" FontFamily="Consolas, MS Gothic" Padding="4" MaxHeight="200"
                                         HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                         Text="{Binding DiffBefore, Mode=OneWay}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource Sub}" Text="変更後" />
                                <TextBox IsReadOnly="True" FontFamily="Consolas, MS Gothic" Padding="4" MaxHeight="200"
                                         HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                         Text="{Binding DiffAfter, Mode=OneWay}" />
                            </StackPanel>
                        </Grid>

                        <!-- W-242〜W-248 / W-252 / W-253 -->
                        <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionHeading}" TextWrapping="Wrap"
                                           Text="{Binding ConfirmHeading}" />
                                <!-- 複数行の読み取り専用の本文。選んでコピーできる -->
                                <TextBox IsReadOnly="True" IsReadOnlyCaretVisible="False" BorderThickness="0"
                                         Background="Transparent" TextWrapping="Wrap" Padding="0" Margin="0,6,0,0"
                                         Text="{Binding ConfirmBody, Mode=OneWay}" />
                                <!-- W-250 -->
                                <TextBlock TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                           Text="{Binding SaveOnlyNote}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>

            <!-- ========== 保存と実行・結果(W-251 / W-270〜W-279) ========== -->
            <StackPanel Visibility="{Binding IsApplyingMode, Converter={StaticResource Visible}}">
                <!-- W-270 -->
                <TextBlock TextWrapping="Wrap" Text="{Binding SavedMessage}"
                           Visibility="{Binding IsSavedMessageVisible, Converter={StaticResource Visible}}" />
                <!-- W-271 -->
                <TextBlock TextWrapping="Wrap" Margin="0,8,0,0" Text="{x:Static m:ProgramsPageViewModel.ApplyingText}" />
            </StackPanel>

            <DockPanel Visibility="{Binding IsResultMode, Converter={StaticResource Visible}}">
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                    <!-- W-276(読み込んだ後に変わっていた) -->
                    <TextBlock VerticalAlignment="Center" Style="{StaticResource Sub}"
                               Text="{x:Static m:ProgramsPageViewModel.ReloadDiscards}"
                               Visibility="{Binding IsConflict, Converter={StaticResource Visible}}" />
                    <Button Padding="{StaticResource ButtonPadding}" Margin="{StaticResource ButtonMargin}" Content="読み込み直す" Command="{Binding ReloadCommand}"
                            Visibility="{Binding IsConflict, Converter={StaticResource Visible}}" />
                    <!-- 結果から一覧に戻る(W-249 の「戻る」と同じ語) -->
                    <Button Padding="{StaticResource ButtonPadding}" Margin="{StaticResource ButtonMargin}" Content="戻る" IsDefault="{Binding IsResultBackDefault}"
                            Command="{Binding BackCommand}"
                            Visibility="{Binding CanReturnFromResult, Converter={StaticResource Visible}}" />
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- W-270 -->
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,8" Text="{Binding SavedMessage}"
                                   Visibility="{Binding IsSavedMessageVisible, Converter={StaticResource Visible}}" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <!-- W-251 / W-272 / W-275 / W-277 / W-278 / W-279 -->
                                <TextBlock TextWrapping="Wrap" FontWeight="SemiBold" Text="{Binding ResultHeading}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ResultIsError}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <!-- W-272〜W-274 / W-247 / W-277(2 行目) -->
                                <TextBox IsReadOnly="True" IsReadOnlyCaretVisible="False" BorderThickness="0"
                                         Background="Transparent" TextWrapping="Wrap" Padding="0" Margin="0,6,0,0"
                                         Text="{Binding ResultBody, Mode=OneWay}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
