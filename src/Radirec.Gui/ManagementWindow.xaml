<!--
  管理画面(requirements §10.3・#151)。ViewModel は Radirec.Gui.Core の ManagementViewModel。
  文言は docs/mockups/management-window.md に従い、各所に W-ID を書いておく(モックと突き合わせるため)。
  ホームと取込履歴以外のページは Pages/ の UserControl に置く
  (番組 = Pages/ProgramsPage.xaml〈#154〉、設定 = Pages/SettingsPage.xaml〈#152〉、バージョン情報 = Pages/AboutPage.xaml〈#157〉)。
  見た目は WPF の Fluent テーマで、Windows のライト / ダークに追従する(#171。ManagementWindow.xaml.cs)。色は名前や SystemColors で
  直に書かず、Fluent の辞書のキー(エラー = SystemFillColorCriticalBrush、注意 = SystemFillColorCautionBrush、
  薄い文字 = TextFillColorSecondaryBrush、枠と区切り = SurfaceStrokeColorDefaultBrush)を DynamicResource で引く。ページもこれに従う。
-->
<Window x:Class="Radirec.Gui.ManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:m="clr-namespace:Radirec.Gui.Core.Management;assembly=Radirec.Gui.Core"
        xmlns:pages="clr-namespace:Radirec.Gui.Pages"
        Title="{x:Static m:ManagementViewModel.Title}"
        Width="1040" Height="700" MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />

        <Style x:Key="PageHeading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="SectionHeading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="Sub" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>

        <!-- ファイル列はファイル名だけを出し、セルの ToolTip にフルパスを出す(列は切り詰められるため。#87)。 -->
        <Style x:Key="FileCell" TargetType="TextBlock">
            <Setter Property="ToolTip" Value="{Binding OutputPath}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <!--
          Button / TextBox / DataGridRow にはキー付きのスタイルを置かない(#171)。WPF のスタイルは 1 つしか効かないので、
          キー付きのスタイルを当てると Fluent テーマの暗黙のスタイルを受け取らず、ダークでもクラシックの見た目になる。
          BasedOn で Fluent を受け継ぐ手も取れない:ページ(UserControl)の XAML はウィンドウの木に入る前に読み込まれ、
          その時点の StaticResource はクラシックのスタイルを引く。見た目の値は各要素の属性に書く。
        -->
    </Window.Resources>

    <DockPanel>
        <!-- W-003 -->
        <Border DockPanel.Dock="Bottom" Padding="12,4"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}">
            <TextBlock Style="{StaticResource Sub}" Text="{x:Static m:ManagementViewModel.CloseNote}" />
        </Border>

        <!-- W-002 ページの切り替え -->
        <ListBox DockPanel.Dock="Left" Width="160" Padding="4,8"
                 BorderThickness="0,0,1,0"
                 ItemsSource="{Binding Source={x:Static m:ManagementViewModel.PageNames}}"
                 SelectedIndex="{Binding CurrentPageIndex}">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="10,7" />
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>

        <Grid>
            <!-- ========== ホーム ========== -->
            <!-- Visibility は外側(DataContext = ManagementViewModel)で結ぶ。同じ要素で DataContext を差し替えると、
                 IsHomePage が Home の側で探されて結べない。 -->
            <Grid Visibility="{Binding IsHomePage, Converter={StaticResource Visible}}">
            <DockPanel Margin="18,14" LastChildFill="False" DataContext="{Binding Home}">
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource PageHeading}" Text="ホーム" />

                <!-- 状態と再スキャン -->
                <Border DockPanel.Dock="Top" Padding="14,10" CornerRadius="4" BorderThickness="1"
                        BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <!-- W-101〜W-105・W-153 -->
                            <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Margin="0,2" />
                            <!-- W-106〜W-108 -->
                            <TextBlock Text="{Binding LastScanText}" TextWrapping="Wrap" Margin="0,2" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="16,0,0,0" MaxWidth="280">
                            <!-- W-110 -->
                            <Button Content="今すぐ再スキャン" Padding="14,5" HorizontalAlignment="Right"
                                    Command="{Binding RescanCommand}" />
                            <!-- W-111(次のスキャンが終わるまで)/ W-112(取り込みが止まっている) -->
                            <TextBlock Text="{Binding RescanNote}" TextWrapping="Wrap" TextAlignment="Right"
                                       Margin="0,6,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ===== 要対応(W-120〜W-139。ADR-0018)===== -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,20,0,6">
                    <TextBlock Style="{StaticResource SectionHeading}" Text="要対応" />
                    <!-- W-120(件数) -->
                    <TextBlock Style="{StaticResource Sub}" Margin="12,0,0,0" VerticalAlignment="Bottom"
                               Text="{Binding AttentionCountText}" />
                </StackPanel>
                <!-- W-137(縮退・計算できなかった) -->
                <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Text="{Binding AttentionError}"
                           Visibility="{Binding IsAttentionErrorVisible, Converter={StaticResource Visible}}" />
                <!-- W-121 -->
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Sub}" Text="{x:Static m:AttentionText.None}"
                           Visibility="{Binding IsAttentionEmpty, Converter={StaticResource Visible}}" />
                <!-- W-139(「分けておく」で書けなかった) -->
                <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,6" Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                           Text="{Binding AttentionNote}"
                           Visibility="{Binding IsAttentionNoteVisible, Converter={StaticResource Visible}}" />
                <!-- 件数が多いと取込履歴が押し出されるので、要対応の欄の中でスクロールする -->
                <ScrollViewer DockPanel.Dock="Top" MaxHeight="280" VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding HasAnyAttention, Converter={StaticResource Visible}}">
                  <StackPanel>
                    <Border Padding="14,8" CornerRadius="4" BorderThickness="1" Margin="0,0,0,6"
                            BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}"
                            Visibility="{Binding HasSiblings, Converter={StaticResource Visible}}">
                        <StackPanel>
                            <!-- W-122 -->
                            <TextBlock FontWeight="SemiBold" Margin="0,0,0,4" Text="{x:Static m:AttentionText.SiblingsHeading}" />
                            <!-- W-138(番組ページに保存していない変更がある) -->
                            <TextBlock Style="{StaticResource Sub}" TextWrapping="Wrap" Margin="0,0,0,4"
                                       Text="{Binding KeepApartBlocked}"
                                       Visibility="{Binding IsKeepApartBlockedVisible, Converter={StaticResource Visible}}" />
                            <ItemsControl ItemsSource="{Binding SiblingRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <!-- W-124 / W-125 -->
                                                <TextBlock TextWrapping="Wrap" Text="{Binding Heading}"
                                                           Visibility="{Binding HasHeading, Converter={StaticResource Visible}}" />
                                                <!-- W-123 -->
                                                <TextBlock TextWrapping="Wrap" Text="{Binding Line}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0"
                                                        VerticalAlignment="Center">
                                                <!-- W-126 / W-127 -->
                                                <Button Content="統合する" Padding="10,2" Command="{Binding IntegrateCommand}" />
                                                <Button Content="分けておく" Padding="10,2" Margin="6,0,0,0"
                                                        Command="{Binding KeepApartCommand}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- ===== 解決していない取込失敗(W-128〜W-133。#156)===== -->
                    <Border Padding="14,8" CornerRadius="4" BorderThickness="1" Margin="0,0,0,6"
                            BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}"
                            Visibility="{Binding HasFailures, Converter={StaticResource Visible}}">
                        <StackPanel>
                            <!-- W-128 -->
                            <TextBlock FontWeight="SemiBold" Margin="0,0,0,2" Text="{x:Static m:AttentionText.FailuresHeading}" />
                            <!-- W-133 -->
                            <TextBlock Style="{StaticResource Sub}" TextWrapping="Wrap" Margin="0,0,0,4"
                                       Text="{x:Static m:AttentionText.FailuresHint}" />
                            <!-- W-146 / W-147(W-132 を押した結果) -->
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" Text="{Binding FailureNote}"
                                       Visibility="{Binding IsFailureNoteVisible, Converter={StaticResource Visible}}" />
                            <ItemsControl ItemsSource="{Binding FailureRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <!-- W-129(1 行目 ファイル名 / 2 行目 理由〈W-130〉/ 3 行目 日時) -->
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock TextWrapping="Wrap" Text="{Binding FileName}" />
                                                <TextBlock TextWrapping="Wrap" Style="{StaticResource Sub}" Text="{Binding Reason}" />
                                                <TextBlock Style="{StaticResource Sub}" Text="{Binding FailedAt}"
                                                           Visibility="{Binding HasFailedAt, Converter={StaticResource Visible}}" />
                                            </StackPanel>
                                            <!-- W-132 -->
                                            <Button Grid.Column="1" Margin="12,0,0,0" Padding="10,2" VerticalAlignment="Center"
                                                    Content="{x:Static m:AttentionText.RevealSource}"
                                                    Command="{Binding RevealCommand}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- ===== 再適用が要る番組(W-134〜W-136。#156)===== -->
                    <Border Padding="14,8" CornerRadius="4" BorderThickness="1"
                            BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}"
                            Visibility="{Binding HasDrift, Converter={StaticResource Visible}}">
                        <StackPanel>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <!-- W-134 -->
                                <TextBlock Grid.Column="0" FontWeight="SemiBold" VerticalAlignment="Center"
                                           Text="{x:Static m:AttentionText.DriftHeading}" />
                                <!-- W-136 -->
                                <Button Grid.Column="1" Padding="10,2" Content="{x:Static m:AttentionText.ReapplyConfirm}"
                                        Command="{Binding ReapplyCommand}" />
                            </Grid>
                            <!-- W-119 / W-256(押せない理由)・W-240(確かめている途中)・W-254 / W-255(押した結果) -->
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" Text="{Binding ReapplyNote}"
                                       Visibility="{Binding IsReapplyNoteVisible, Converter={StaticResource Visible}}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsReapplyNoteWarning}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <!-- W-135 / W-158(出力先から消す予定。ADR-0021) -->
                            <ItemsControl ItemsSource="{Binding DriftRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock TextWrapping="Wrap" Margin="0,2" Text="{Binding Line}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- ===== 差し替え放送の疑い(W-155〜W-157。ADR-0021)。判断のボタンは #235 ===== -->
                    <Border Padding="14,8" CornerRadius="4" BorderThickness="1" Margin="0,6,0,0"
                            BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}"
                            Visibility="{Binding HasSubstitutes, Converter={StaticResource Visible}}">
                        <StackPanel>
                            <!-- W-155 -->
                            <TextBlock FontWeight="SemiBold" Margin="0,0,0,2" Text="{x:Static m:AttentionText.SubstituteHeading}" />
                            <!-- W-157 -->
                            <TextBlock Style="{StaticResource Sub}" TextWrapping="Wrap" Margin="0,0,0,4"
                                       Text="{x:Static m:AttentionText.SubstituteHint}" />
                            <!-- W-156 -->
                            <ItemsControl ItemsSource="{Binding SubstituteRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock TextWrapping="Wrap" Margin="0,2" Text="{Binding Line}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                  </StackPanel>
                </ScrollViewer>

                <!-- 取込履歴(新しい方の 5 件)。W-140 -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,20,0,6">
                    <TextBlock Style="{StaticResource SectionHeading}" Text="取込履歴" />
                    <TextBlock Style="{StaticResource Sub}" Margin="12,0,0,0" VerticalAlignment="Bottom"
                               Text="{Binding RecentCaption}" />
                </StackPanel>
                <!-- W-150 -->
                <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap"
                           Text="{x:Static m:HistoryText.Unavailable}"
                           Visibility="{Binding IsHistoryUnavailable, Converter={StaticResource Visible}}" />
                <!-- W-149 -->
                <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap"
                           Text="{x:Static m:HistoryText.LoadFailed}"
                           Visibility="{Binding IsHistoryFailed, Converter={StaticResource Visible}}" />
                <!-- W-154(最初の読み込みの途中。読み直しの間は前の行を出したまま) -->
                <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap"
                           Text="{x:Static m:HistoryText.Loading}"
                           Visibility="{Binding IsHistoryLoading, Converter={StaticResource Visible}}" />
                <StackPanel DockPanel.Dock="Top"
                            Visibility="{Binding IsHistoryLoaded, Converter={StaticResource Visible}}">
                    <!-- W-141(列)。ホームの数件は並べ替えない(常に新しい順) -->
                    <DataGrid ItemsSource="{Binding RecentRows}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              CanUserSortColumns="False" CanUserReorderColumns="False"
                              HeadersVisibility="Column" SelectionMode="Single"
                              GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="番組" Binding="{Binding Program}" Width="240" />
                            <DataGridTextColumn Header="放送局" Binding="{Binding Station}" Width="120" />
                            <DataGridTextColumn Header="放送" Binding="{Binding Broadcast}" Width="150" />
                            <DataGridTextColumn Header="取込日時" Binding="{Binding ImportedAt}" Width="140" />
                            <DataGridTextColumn Header="ファイル" Binding="{Binding FileName}" Width="*"
                                                ElementStyle="{StaticResource FileCell}" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <!-- W-142 -->
                    <Button Content="すべて表示" Padding="12,3" Margin="0,6,0,0" HorizontalAlignment="Right"
                            Command="{Binding ShowAllCommand}" />
                </StackPanel>
            </DockPanel>
            </Grid>

            <!-- ========== 取込履歴(全件) ========== -->
            <Grid Visibility="{Binding IsHistoryPage, Converter={StaticResource Visible}}">
            <DockPanel Margin="18,14" DataContext="{Binding History}">
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource PageHeading}" Text="取込履歴" />
                <!-- W-150 -->
                <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap"
                           Text="{x:Static m:HistoryText.Unavailable}"
                           Visibility="{Binding IsUnavailable, Converter={StaticResource Visible}}" />

                <!-- 「更新」(W-143)・件数(W-151)/ 読み込み失敗(W-149)・開く / コピーの結果(W-146〜W-148)。
                     StackPanel ではなく DockPanel にする。横積みだと結果の欄に無限の幅が渡り、長いパスが省略されずに
                     はみ出すため(旧取込履歴ウィンドウと同じ)。 -->
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6" LastChildFill="True"
                           Visibility="{Binding IsAvailable, Converter={StaticResource Visible}}">
                    <Button DockPanel.Dock="Left" Content="更新" Padding="14,3" Command="{Binding RefreshCommand}" />
                    <TextBlock DockPanel.Dock="Left" Margin="12,0,0,0" VerticalAlignment="Center"
                               Text="{Binding CountText}" />
                    <TextBlock Margin="16,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               Text="{Binding ActionMessage}" ToolTip="{Binding ActionMessage}" />
                </DockPanel>

                <!-- 詳細欄(W-145) -->
                <Border DockPanel.Dock="Bottom" Padding="10,6,10,8" BorderThickness="0,1,0,0"
                        BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}"
                        Visibility="{Binding IsLoaded, Converter={StaticResource Visible}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="出力先" Margin="0,2,12,2" />
                        <!-- 選択・コピーできる読み取り専用のパス(W-145)。長いので折り返して全文を見せる -->
                        <TextBox Grid.Row="0" Grid.Column="1" IsReadOnly="True" IsReadOnlyCaretVisible="False"
                                 BorderThickness="0" Background="Transparent" TextWrapping="Wrap" Padding="0" Margin="0,2"
                                 Text="{Binding SelectedOutputPath, Mode=OneWay}" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="取込元" Margin="0,2,12,2" />
                        <TextBox Grid.Row="1" Grid.Column="1" IsReadOnly="True" IsReadOnlyCaretVisible="False"
                                 BorderThickness="0" Background="Transparent" TextWrapping="Wrap" Padding="0" Margin="0,2"
                                 Text="{Binding SelectedSourcePath, Mode=OneWay}" />
                    </Grid>
                </Border>

                <!-- W-141。列の見出しで並べ替えられる。行のダブルクリック・Enter で出力先を開く -->
                <DataGrid ItemsSource="{Binding Rows}"
                          SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                          Visibility="{Binding IsLoaded, Converter={StaticResource Visible}}"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" CanUserDeleteRows="False"
                          HeadersVisibility="Column" SelectionMode="Single"
                          GridLinesVisibility="Horizontal"
                          PreviewKeyDown="OnHistoryGridPreviewKeyDown"
                          MouseDoubleClick="OnHistoryGridDoubleClick"
                          PreviewMouseRightButtonDown="OnHistoryGridRightButtonDown">
                    <!-- RowStyle は置かない(Fluent の行のスタイルを上書きするため。#171)。行の操作は DataGrid で受けて行を探す -->

                    <!-- W-144 -->
                    <DataGrid.ContextMenu>
                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                            <MenuItem Header="出力先をエクスプローラーで開く" Command="{Binding RevealOutputCommand}" />
                            <MenuItem Header="取込元をエクスプローラーで開く" Command="{Binding RevealSourceCommand}" />
                            <Separator />
                            <MenuItem Header="出力先のパスをコピー" Command="{Binding CopyOutputCommand}" />
                            <MenuItem Header="取込元のパスをコピー" Command="{Binding CopySourceCommand}" />
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="番組" Binding="{Binding Program}" Width="240" />
                        <DataGridTextColumn Header="放送局" Binding="{Binding Station}" Width="120" />
                        <DataGridTextColumn Header="放送" Binding="{Binding Broadcast}" Width="150" />
                        <DataGridTextColumn Header="取込日時" Binding="{Binding ImportedAt}" Width="140" />
                        <DataGridTextColumn Header="ファイル" Binding="{Binding FileName}" Width="*"
                                            ElementStyle="{StaticResource FileCell}" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
            </Grid>

            <!-- ========== 番組(#154) ========== -->
            <Grid Visibility="{Binding IsProgramsPage, Converter={StaticResource Visible}}">
                <pages:ProgramsPage DataContext="{Binding Programs}" />
            </Grid>

            <!-- ========== 設定(#152)。Visibility は外側で結ぶ(ホームと同じ理由) ========== -->
            <Grid Visibility="{Binding IsSettingsPage, Converter={StaticResource Visible}}">
                <pages:SettingsPage DataContext="{Binding Settings}" />
            </Grid>
            <!-- ========== バージョン情報(#157)。Visibility は外側で結ぶ(ホームと同じ理由) ========== -->
            <Grid Visibility="{Binding IsAboutPage, Converter={StaticResource Visible}}">
                <pages:AboutPage DataContext="{Binding About}" />
            </Grid>
        </Grid>
    </DockPanel>
</Window>
