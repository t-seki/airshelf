<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <ProjectReference Include="..\Radirec.Core\Radirec.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- 取込要約シグナルを EventLog へ書く(ADR-0008)。API は Windows 専用のため
         呼び出しは OperatingSystem.IsWindows() ガードと [SupportedOSPlatform] で保護する。 -->
    <PackageReference Include="System.Diagnostics.EventLog" />
  </ItemGroup>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
</Project>
