<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- トレイ(Airshelf.Gui)と同じ版のホストで、BackgroundService の起動の挙動を確かめる(#217)。 -->
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="System.IO.Abstractions.TestingHelpers" />
    <PackageReference Include="TagLibSharp" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Fixtures\**\*" CopyToOutputDirectory="PreserveNewest" />
    <!-- install.ps1 が配置する sample 設定が ConfigLoader で解析できることを検証するため出力へコピー。 -->
    <None Include="..\..\config\*.sample.json" Link="Samples\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Airshelf.Core\Airshelf.Core.csproj" />
    <ProjectReference Include="..\..\src\Airshelf.Hosting\Airshelf.Hosting.csproj" />
    <ProjectReference Include="..\..\src\Airshelf.Gui.Core\Airshelf.Gui.Core.csproj" />
    <ProjectReference Include="..\..\src\Airshelf.Cli.Core\Airshelf.Cli.Core.csproj" />
  </ItemGroup>

</Project>
