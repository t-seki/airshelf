<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="System.IO.Abstractions.TestingHelpers" />
    <PackageReference Include="TagLibSharp" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Fixtures\**\*" CopyToOutputDirectory="PreserveNewest" />
    <!-- install.ps1 が配置する sample 設定が ConfigLoader で解析できることを検証するため出力へコピー。 -->
    <None Include="..\..\config\*.sample.json" Link="Samples\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Radirec.Core\Radirec.Core.csproj" />
    <ProjectReference Include="..\..\src\Radirec.Hosting\Radirec.Hosting.csproj" />
    <ProjectReference Include="..\..\src\Radirec.Gui.Core\Radirec.Gui.Core.csproj" />
  </ItemGroup>

</Project>
