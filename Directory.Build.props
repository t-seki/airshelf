<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <!-- 版はタグ駆動で CI が Version プロパティを注入する(ADR-0005 / #16)。
         ローカル/非 CI ビルドはこのフォールバックが airshelf の version 出力になる。 -->
    <Version>0.0.0-dev</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- CI は `dotnet build -warnaserror` で走る(#104)。-warnaserror は csc の警告だけでなく
         **MSBuild セッション中の全警告**を落とすため、NuGetAudit の脆弱性警告(NU1901-1904)も
         エラーになる。それだと**こちらのコードを一切変えていない PR が、依存に新規 CVE が登録された
         日に突然落ちる**(しかも直せるのは依存の更新待ち)。CI の役目は「この変更が壊れていないか」なので、
         依存の脆弱性はエラーにせず**警告として見せる**に留める。脆弱性の監視は別の関心事・別の頻度で
         扱う(#106)。 -->
    <WarningsNotAsErrors>NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
  </PropertyGroup>

</Project>
